diff --git a/include/sbd/framework/hang_trace.h b/include/sbd/framework/hang_trace.h
new file mode 100644
index 0000000..996daf0
--- /dev/null
+++ b/include/sbd/framework/hang_trace.h
@@ -0,0 +1,84 @@
+/// This is a part of sbd
+/**
+@file sbd/framework/hang_trace.h
+@brief Lightweight, flushed, rank-aware phase tracing to locate hangs.
+
+Enable at runtime with the environment variable SBD_TRACE=1 (any value other
+than empty or "0"). When disabled, every SBD_TRACE(...) call is a no-op, so
+this header is safe to leave in place for normal production runs.
+
+Output goes to stderr (unbuffered + explicitly flushed) so that the LAST line
+printed before a hang reliably tells you which phase, and which MPI ranks, are
+stuck. Each line is composed as a single string before writing to avoid lines
+from different ranks interleaving mid-line.
+
+Example line:
+  [SBD_TRACE rank 2 t=12.345s] diag: Davidson begin
+*/
+#ifndef SBD_FRAMEWORK_HANG_TRACE_H
+#define SBD_FRAMEWORK_HANG_TRACE_H
+
+#include <cstdio>
+#include <cstdlib>
+#include <chrono>
+#include <string>
+#include <sstream>
+
+#include "mpi.h"
+
+namespace sbd {
+
+  /// Seconds elapsed since the first trace call (monotonic clock).
+  inline double trace_elapsed_sec() {
+    static const auto t0 = std::chrono::steady_clock::now();
+    auto now = std::chrono::steady_clock::now();
+    return std::chrono::duration<double>(now - t0).count();
+  }
+
+  /// World rank, or -1 if MPI is not initialized yet.
+  inline int trace_world_rank() {
+    int initialized = 0;
+    MPI_Initialized(&initialized);
+    if (!initialized) return -1;
+    int rank = -1;
+    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
+    return rank;
+  }
+
+  /// Read SBD_TRACE once; tracing is on unless it is unset, empty, or "0".
+  inline bool trace_enabled() {
+    static const bool on = []() {
+      const char * e = std::getenv("SBD_TRACE");
+      return e != nullptr && e[0] != '\0' && std::string(e) != "0";
+    }();
+    return on;
+  }
+
+  /// Emit a single flushed trace line to stderr.
+  inline void trace_emit(const char * where) {
+    std::ostringstream oss;
+    oss << "[SBD_TRACE rank " << trace_world_rank()
+        << " t=" << trace_elapsed_sec() << "s] " << where << '\n';
+    const std::string line = oss.str();
+    std::fputs(line.c_str(), stderr);
+    std::fflush(stderr);
+  }
+
+} // namespace sbd
+
+/**
+   SBD_TRACE(expr): stream-style marker, e.g.
+     SBD_TRACE("diag: Davidson begin");
+     SBD_TRACE("Davidson it=" << it << " ib=" << ib << " mult begin");
+   No-op (and arguments not evaluated beyond the cheap guard) when disabled.
+*/
+#define SBD_TRACE(expr)                                                        \
+  do {                                                                         \
+    if (::sbd::trace_enabled()) {                                              \
+      std::ostringstream _sbd_trace_oss;                                       \
+      _sbd_trace_oss << expr;                                                  \
+      ::sbd::trace_emit(_sbd_trace_oss.str().c_str());                         \
+    }                                                                          \
+  } while (0)
+
+#endif
